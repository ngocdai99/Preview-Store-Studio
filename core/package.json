{
  "name": "store-preview-studio",
  "version": "2.1.0",
  "description": "Zero-server offline app store preview & ASO mockup studio for Apple App Store and Google Play",
  "main": "build.js",
  "scripts": {
    "dev": "node dev.js",
    "dev:marketing": "node dev-marketing.js",
    "dev:demo": "node dev-marketing.js 4000 demo.html",
    "build": "node build.js",
    "release": "node release.js",
    "showcase": "node scripts/build-showcase-data.js",
    "build:marketing": "node scripts/build-marketing.js",
    "build:marketing:vi": "node scripts/build-marketing-vi.js",
    "generate:og": "python3 scripts/generate-og-image.py",
    "check:og": "python3 scripts/generate-og-image.py --check-only",
    "build:demo": "node scripts/build-demo.js",
    "watch:demo": "node scripts/build-demo.js --watch",
    "deploy": "npx --yes surge docs preview-studio-app-vi.surge.sh",
    "deploy:cf": "node scripts/build-marketing.js && node scripts/build-marketing-vi.js && npx wrangler pages deploy cloudflare --project-name store-preview-studio",
    "test": "node scripts/test-runner.js"
  },
  "keywords": [
    "app-store",
    "google-play",
    "aso",
    "mockup",
    "screenshots",
    "preview-studio"
  ],
  "author": "Kai DevLabs <kai.devlabs@gmail.com>",
  "license": "Commercial"
}
